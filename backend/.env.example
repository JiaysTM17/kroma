# KROMA Backend Local-First Configuration (no cloud credentials required)
KROMA_ENVIRONMENT=local
KROMA_DATABASE_BACKEND=sqlite
KROMA_STORAGE_BACKEND=local
# Optional PostgreSQL 16 (when KROMA_DATABASE_BACKEND=postgres)
# KROMA_POSTGRES_DSN=postgresql://user:pass@localhost:5432/kroma
# Optional S3 / Cloudflare R2 (when KROMA_STORAGE_BACKEND=s3)
# KROMA_S3_BUCKET=kroma-assets
# KROMA_S3_ENDPOINT_URL=
# KROMA_S3_REGION=auto
# KROMA_S3_ACCESS_KEY_ID=
# KROMA_S3_SECRET_ACCESS_KEY=
